# Copie este arquivo para ".env.local" e preencha os valores.
# .env.local nunca é commitado (já está no .gitignore).

# String de conexão do banco Postgres (Neon, via Vercel Marketplace ou neon.tech direto).
# Se deixar em branco, o sistema usa automaticamente um arquivo JSON local
# em data/db.json (bom para desenvolvimento, mas NÃO funciona em produção na Vercel).
DATABASE_URL=

# Chave da API do Google Gemini, para o recurso de geração de e-mail por IA.
# Opcional: também pode ser configurada pela tela /configuracoes dentro do app.
GEMINI_API_KEY=

# ==================== LOGIN / SEGURANÇA ====================

# Segredo usado para assinar as sessões de login (obrigatório em produção).
# Gere um valor aleatório longo, por exemplo rodando: openssl rand -hex 32
AUTH_SECRET=

# Usuário e senha do administrador inicial. Usados APENAS na primeira vez que
# alguém tentar logar, para criar a primeira conta — depois disso pode remover
# essas duas variáveis (ou deixar, elas não sobrescrevem contas já criadas).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Senha simples e compartilhada para o painel somente-leitura /viewer
# (Visão Coordenadora). Também só é usada na primeira vez; depois disso pode
# ser trocada dentro do app, em Configurações > Segurança & Acesso.
VIEWER_PASSWORD=
